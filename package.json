{
  "name": "agent-orch-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test tests/engine/*.test.ts tests/contract/*.test.ts",
    "test:python": "PYTHONPATH=python/src python3 -m unittest discover -s python/tests -v",
    "typecheck": "tsc --noEmit",
    "cli": "node packages/cli/src/main.ts",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tests/**/*.ts\" \"examples/typescript/*.ts\" \"schemas/*.json\" package.json tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  }
}
